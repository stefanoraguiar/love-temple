# Caixa que recebe as inscrições, via FormSubmit.
# O endereço fica visível na página publicada, porque o browser envia o formulário.
# Na primeira utilização, o FormSubmit pede um clique no email de ativação.
INSCRICAO_EMAIL=

# Link de pagamento Stripe (Payment Link).
# Tem de ser https e um domínio stripe.com, por exemplo:
# https://buy.stripe.com/xxxxxxxx
STRIPE_PAYMENT_LINK=

# Email para pedidos de acesso, correção ou apagamento (RGPD).
# Se ficar vazio, a página de privacidade usa INSCRICAO_EMAIL.
CONTACT_EMAIL=
